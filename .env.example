# Nothing here is needed for the default (practice mock) mode.
# Real mode only: `reasoning-delta probe --base-url ... --model ... [--api-key-env NAME]`
# Local servers (Ollama, llama.cpp, vLLM) usually need no key.
# The CLI only reads the NAME of a variable; never pass the key itself on the command line.

# Default variable read when --api-key-env is not given and this one is set
OPENAI_API_KEY=
# Example for a remote API: reasoning-delta probe --base-url https://api.deepseek.com --model <model> --api-key-env DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# CLI language: en | ko (--lang wins, then this, then LC_ALL / LC_MESSAGES / LANG)
REASONING_DELTA_LANG=
